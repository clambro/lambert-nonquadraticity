import Lambert.Results.MainTheorem
import Lambert.Arithmetic.RadicalHeight

/-! # Lambert values at positive radical bases -/
namespace Lambert
noncomputable section
open Polynomial IntermediateField

/-- A real base q>1 with q^n a positive integer has no degree-e relation over Q(q) when e*[Q(q):Q]*(42963+428220/π²)<202140. -/
theorem lambertValue_no_relation_of_radical_degree_margin
    (q : ℝ) (hq : 1 < q) (n m : ℕ) (hn : 0 < n) (hpow : q^n=m)
    (e : ℕ) (hmargin : (e : ℝ)*(Module.finrank ℚ ℚ⟮q⟯ : ℝ)*(42963+428220/Real.pi^2)<202140)
    (p : (ℚ⟮q⟯)[X]) (hp : p.natDegree ≤ e)
    (hroot : p.eval₂ (ℚ⟮q⟯).subtype (lambertValue q)=0) : p=0 := by
  have hqi : IsIntegral ℚ q := ⟨X^n-C (m : ℚ), monic_X_pow_sub_C _ hn.ne', by simp [hpow]⟩
  let : FiniteDimensional ℚ ℚ⟮q⟯ := adjoin.finiteDimensional hqi
  let : NumberField ℚ⟮q⟯ := {}
  apply lambertValue_no_relation_of_numberField_height ℚ⟮q⟯ (AdjoinSimple.gen ℚ q) hq
    e ?_ p hp hroot
  rw [radical_generatedField_height_eq q hq n m hn hpow]
  change (e : ℝ)*(42963+428220/Real.pi^2)*((Module.finrank ℚ ℚ⟮q⟯ : ℝ)*Real.log q) < 202140*Real.log q
  simpa only [mul_assoc, mul_left_comm, mul_comm] using
    mul_lt_mul_of_pos_right hmargin (Real.log_pos hq)

/-- The exponent margin e*n*(42963+428220/π²)<202140 excludes degree-e relations at a real radical q>1 with q^n=m. -/
theorem lambertValue_no_relation_of_radical_margin
    (q : ℝ) (hq : 1 < q) (n m : ℕ) (hn : 0 < n) (hpow : q^n=m)
    (e : ℕ) (hmargin : (e : ℝ)*n*(42963+428220/Real.pi^2)<202140)
    (p : (ℚ⟮q⟯)[X]) (hp : p.natDegree ≤ e)
    (hroot : p.eval₂ (ℚ⟮q⟯).subtype (lambertValue q)=0) : p=0 := by
  apply lambertValue_no_relation_of_radical_degree_margin q hq n m hn hpow e ?_ p hp hroot
  have hd : (Module.finrank ℚ ℚ⟮q⟯ : ℝ) ≤ n := by
    exact_mod_cast radical_generatedField_finrank_le q n m hn hpow
  have hc : 0 ≤ (e : ℝ)*(42963+428220/Real.pi^2) := by positivity
  nlinarith [mul_le_mul_of_nonneg_left hd hc]

/-- The Lambert value at the square root of every integer at least two lies outside the field generated by that square root. -/
theorem lambertValue_sqrt_not_mem
    (m : ℕ) (hm : 2 ≤ m) : lambertValue (Real.sqrt m) ∉ ℚ⟮Real.sqrt (m : ℝ)⟯ := by
  intro hx
  have hmR : (1 : ℝ)<m := by exact_mod_cast (show 1<m by omega)
  have hq : 1 < Real.sqrt (m : ℝ) := by
    nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ m by positivity), Real.sqrt_nonneg (m : ℝ)]
  let a : ℚ⟮Real.sqrt (m : ℝ)⟯ := ⟨_, hx⟩
  have hroot : (X-C a : (ℚ⟮Real.sqrt (m : ℝ)⟯)[X]).eval₂
      (ℚ⟮Real.sqrt (m : ℝ)⟯).subtype (lambertValue (Real.sqrt m))=0 := by
    have hh := Polynomial.eval₂_sub (ℚ⟮Real.sqrt (m : ℝ)⟯).subtype
      (p := (X : (ℚ⟮Real.sqrt (m : ℝ)⟯)[X])) (q := C a) (x := lambertValue (Real.sqrt m))
    exact hh.trans (by rw [eval₂_X, eval₂_C]; exact sub_self _)
  have he := lambertValue_no_relation_of_radical_margin (Real.sqrt m) hq 2 m
    (by omega) (Real.sq_sqrt (by positivity)) 1
    (by simpa only [Nat.cast_ofNat, Nat.cast_one, one_mul] using lambert_main_degree_two_margin)
    (X-C a) (by compute_degree) hroot
  have hh := congrArg (fun p : (ℚ⟮Real.sqrt (m : ℝ)⟯)[X] => p.coeff 1) he
  simp at hh
end
end Lambert
