import Lambert.Determinants.NumberField
import Lambert.Arithmetic.NumberFieldHeightMahler

/-! # Relative algebraic-degree exclusion over fields containing the base -/
namespace Lambert
noncomputable section
open Polynomial IntermediateField

/-- The degree-weighted height margin excludes polynomial relations over any real number field containing the Lambert base. -/
theorem lambertValue_no_relation_of_numberField_height
    (K : IntermediateField ℚ ℝ) [NumberField K] (q : K) (hq : 1 < (q : ℝ))
    (e : ℕ) (hm : (e : ℝ)*(42963+428220/Real.pi^2)*Height.logHeight₁ q <
      202140*Real.log (q : ℝ)) (p : K[X]) (hp : p.natDegree ≤ e)
    (hroot : p.eval₂ K.subtype (lambertValue (q : ℝ))=0) : p=0 := by
  by_contra hp0
  let x := lambertValue (q : ℝ)
  have hx : IsAlgebraic K x := ⟨p, hp0, hroot⟩
  let E := K⟮x⟯
  let : FiniteDimensional K E := adjoin.finiteDimensional hx.isIntegral
  let : FiniteDimensional ℚ E := Module.Finite.trans K E
  let : NumberField E := {}
  let qE : E := algebraMap K E q
  let xE : E := AdjoinSimple.gen K x
  let σ : E →+* ℂ := Complex.ofRealHom.comp (E.subtype)
  have hl := lambertValue_numberField_height_lower_bound σ qE xE (q : ℝ) hq rfl rfl
  have hheight : Height.logHeight₁ qE = (Module.finrank K E : ℝ)*Height.logHeight₁ q :=
    numberField_logHeight_extension q
  have hdeg : Module.finrank K E ≤ e := by
    rw [adjoin.finrank hx.isIntegral]
    exact (natDegree_le_of_dvd (minpoly.dvd K x hroot) hp0).trans hp
  have hdegR : (Module.finrank K E : ℝ) ≤ e := by exact_mod_cast hdeg
  rw [hheight] at hl
  have hcost : (42963+428220/Real.pi^2)*((Module.finrank K E : ℝ)*Height.logHeight₁ q) ≤
      (e : ℝ)*(42963+428220/Real.pi^2)*Height.logHeight₁ q := by
    calc
      _ = (Module.finrank K E : ℝ)*((42963+428220/Real.pi^2)*Height.logHeight₁ q) := by ring
      _ ≤ (e : ℝ)*((42963+428220/Real.pi^2)*Height.logHeight₁ q) :=
        mul_le_mul_of_nonneg_right hdegR (mul_nonneg (by positivity) (Height.zero_le_logHeight₁ q))
      _ = _ := by ring
  exact (not_lt_of_ge (hl.trans hcost)) hm

/-- The Mahler-measure margin excludes every polynomial relation of degree at most e over the field generated by the base. -/
theorem lambertValue_no_relation_of_mahler_margin
    (q : ℝ) (hq : 1 < q)
    (f : ℤ[X]) (hfprim : f.IsPrimitive) (hfirr : Irreducible (f.map (Int.castRingHom ℚ)))
    (hfroot : f.eval₂ (Int.castRingHom ℝ) q=0)
    (e : ℕ) (hm : (e : ℝ)*(42963+428220/Real.pi^2)*(f.map (Int.castRingHom ℂ)).logMahlerMeasure <
      202140*Real.log q)
    (p : (ℚ⟮q⟯)[X]) (hp : p.natDegree ≤ e)
    (hroot : p.eval₂ (ℚ⟮q⟯).subtype (lambertValue q)=0) : p=0 := by
  have hfQroot : aeval q (f.map (Int.castRingHom ℚ))=0 := by
    rw [aeval_def, eval₂_map]
    have hc : (algebraMap ℚ ℝ).comp (Int.castRingHom ℚ) = Int.castRingHom ℝ := Subsingleton.elim _ _
    rw [hc]
    exact hfroot
  have hqalg : IsAlgebraic ℚ q := ⟨_, hfirr.ne_zero, hfQroot⟩
  let : FiniteDimensional ℚ ℚ⟮q⟯ := adjoin.finiteDimensional hqalg.isIntegral
  let : NumberField ℚ⟮q⟯ := {}
  let qK : ℚ⟮q⟯ := AdjoinSimple.gen ℚ q
  have hfK : f.eval₂ (Int.castRingHom ℚ⟮q⟯) qK=0 := by
    apply (ℚ⟮q⟯).subtype.injective
    rw [map_zero, hom_eval₂]
    have hc : (ℚ⟮q⟯).subtype.comp (Int.castRingHom ℚ⟮q⟯) = Int.castRingHom ℝ := Subsingleton.elim _ _
    rw [hc]
    exact hfroot
  have hdegree : f.natDegree = Module.finrank ℚ ℚ⟮q⟯ := by
    rw [adjoin.finrank hqalg.isIntegral]
    have ha := (minpoly.irreducible hqalg.isIntegral).associated_of_dvd hfirr
      (minpoly.dvd ℚ q hfQroot)
    have := natDegree_eq_of_degree_eq (degree_eq_degree_of_associated ha)
    simpa only [natDegree_map_eq_of_injective (f := Int.castRingHom ℚ) Int.cast_injective] using this.symm
  have hdpos : 0 < (Module.finrank ℚ ℚ⟮q⟯ : ℝ) := by exact_mod_cast Module.finrank_pos (R := ℚ) (M := ℚ⟮q⟯)
  have hheight : Height.logHeight₁ qK = (f.map (Int.castRingHom ℂ)).logMahlerMeasure := by
    have ht := numberField_logHeight_eq_mahler qK f hfprim hfirr hfK
    rw [hdegree] at ht
    exact mul_left_cancel₀ hdpos.ne' ht
  apply lambertValue_no_relation_of_numberField_height ℚ⟮q⟯ qK hq
    e ?_ p hp hroot
  rw [hheight]
  exact hm
/-- The Mahler margin forces an algebraic Lambert value to have relative degree greater than the prescribed bound over the base field. -/
theorem lambertValue_relative_degree_gt_of_mahler_margin
    (q : ℝ) (hq : 1 < q)
    (f : ℤ[X]) (hfprim : f.IsPrimitive) (hfirr : Irreducible (f.map (Int.castRingHom ℚ)))
    (hfroot : f.eval₂ (Int.castRingHom ℝ) q=0)
    (e : ℕ) (hm : (e : ℝ)*(42963+428220/Real.pi^2)*(f.map (Int.castRingHom ℂ)).logMahlerMeasure <
      202140*Real.log q)
    (halg : IsAlgebraic ℚ⟮q⟯ (lambertValue q)) :
    e < Module.finrank ℚ⟮q⟯ (ℚ⟮q⟯)⟮lambertValue q⟯ := by
  rw [adjoin.finrank halg.isIntegral]
  by_contra! hle
  have hz := lambertValue_no_relation_of_mahler_margin q hq f hfprim hfirr hfroot e hm
    (minpoly ℚ⟮q⟯ (lambertValue q)) hle (by exact minpoly.aeval ℚ⟮q⟯ (lambertValue q))
  exact minpoly.ne_zero halg.isIntegral hz

end
end Lambert
